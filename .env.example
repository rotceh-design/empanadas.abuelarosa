# Firebase (Panel de control de Firebase > Configuración > Tus apps > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desarrollo con emuladores locales (opcional): 1 para activar
VITE_USE_FIREBASE_EMULATOR=0

# Cloud Functions (recomendaciones IA) — NO exponer la API key en el frontend.
# Se configura con: firebase functions:secrets:set ANTHROPIC_API_KEY
# El frontend solo llama a la URL pública de la función:
VITE_AI_RECOMMEND_URL=
